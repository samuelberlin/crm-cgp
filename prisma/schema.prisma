// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CGP
}

model Tenant {
  id            String        @id @default(cuid())
  name          String
  createdAt     DateTime      @default(now())
  users         User[]
  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]
  meetings      Meeting[]
  notes         Note[]
  activities    Activity[]
  wealthItems   WealthItem[]
  documents     Document[]
  products      Product[]
  subscriptions Subscription[]
  fiscalReminders FiscalReminder[]

  // Délais d'automatisation (en jours), configurables depuis Paramètres.
  firstContactDelayDays      Int @default(1)
  meetingReportDelayDays     Int @default(1)
  proposalFollowUpDelayDays  Int @default(3)
  inactivityAlertDays        Int @default(30)

  @@map("tenant")
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          Role          @default(CGP)
  tenantId      String?
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  accounts      Account[]
  contacts      Contact[]
  opportunities Opportunity[]
  tasks         Task[]
  meetings      Meeting[]
  notes         Note[]
  activities    Activity[]
  documents     Document[]

  @@unique([email])
  @@index([tenantId])
  @@map("user")
}

enum ContactStatus {
  PROSPECT
  CLIENT
  ANCIEN_CLIENT
  PARTENAIRE
}

model Contact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  status    ContactStatus @default(PROSPECT)
  source    String?
  potential Float?
  notes     String?

  nextAction    String?
  lastContactAt DateTime?
  nextContactAt DateTime?

  birthDate     DateTime?
  profession    String?
  address       String?
  postalCode    String?
  city          String?
  maritalStatus String?

  advisorId String?
  advisor   User?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  activities    Activity[]
  opportunities Opportunity[]
  tasks         Task[]
  meetings      Meeting[]
  contactNotes  Note[]
  wealthItems   WealthItem[]
  documents     Document[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([advisorId])
  @@map("contact")
}

enum OpportunityCategory {
  INVESTISSEMENT
  RETRAITE
  IMMOBILIER
  ASSURANCE
  FISCALITE
  TRANSMISSION
  AUTRE
}

enum OpportunityStage {
  NOUVEAU
  QUALIFIE
  RENDEZ_VOUS
  PROPOSITION
  NEGOCIATION
  GAGNE
  PERDU
}

model Opportunity {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title              String
  category           OpportunityCategory @default(AUTRE)
  amount             Float?
  probability        Int                 @default(50)
  stage              OpportunityStage    @default(NOUVEAU)
  estimatedCloseDate DateTime?
  note               String?
  nextAction         String?

  advisorId String?
  advisor   User?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  activities Activity[]
  tasks      Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([advisorId])
  @@map("opportunity")
}

enum TaskPriority {
  HAUTE
  NORMALE
  BASSE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  TERMINEE
}

model Task {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title    String
  priority TaskPriority @default(NORMALE)
  status   TaskStatus   @default(A_FAIRE)
  dueDate  DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  advisorId String?
  advisor   User?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([advisorId])
  @@map("task")
}

enum MeetingStatus {
  PLANIFIE
  REALISE
  ANNULE
}

model Meeting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  date     DateTime
  location String?
  notes    String?
  status   MeetingStatus @default(PLANIFIE)

  // Base de travail pour le résumé d'entretien IA envoyé au client : ce qu'il a
  // exprimé vouloir (avant/pendant le RDV) et ce que le conseiller lui préconise
  // (généralement renseigné après le RDV).
  objectives      String?
  recommendations String?

  advisorId String?
  advisor   User?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([advisorId])
  @@map("meeting")
}

model Note {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  content String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@map("note")
}

enum ActivityType {
  CONTACT_CREATED
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
  TASK_CREATED
  TASK_COMPLETED
  MEETING_SCHEDULED
  MEETING_COMPLETED
  NOTE_ADDED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
}

model Activity {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type          ActivityType
  label         String
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@index([opportunityId])
  @@map("activity")
}

enum WealthKind {
  ACTIF
  PASSIF
}

enum WealthCategory {
  IMMOBILIER
  FINANCIER
  LIQUIDITES
  PROFESSIONNEL
  AUTRE
  CREDIT
  AUTRE_DETTE
}

model WealthItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  kind     WealthKind
  category WealthCategory
  label    String?
  amount   Float

  // Renseigné quand cet actif provient d'une souscription (Retraite/Épargne) : garde
  // le patrimoine synchronisé avec l'encours des produits réellement détenus par le client.
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@map("wealth_item")
}

enum ProductCategory {
  PREVOYANCE
  SANTE
  RETRAITE
  EPARGNE
  DOMMAGES
}

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  category    ProductCategory
  provider    String?
  description String?
  active      Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("product")
}

enum SubscriptionStatus {
  ACTIVE
  ANNULE
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  encours      Float    @default(0)
  subscribedAt DateTime @default(now())
  status       SubscriptionStatus @default(ACTIVE)
  note         String?

  wealthItem WealthItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([productId])
  @@map("subscription")
}

/**
 * Rappel annuel récurrent (jour + mois, sans année) : versement PER avant fin
 * d'année, période de déclaration de revenus, etc. Configurable par cabinet,
 * affiché sur le dashboard trié par proximité.
 */
model FiscalReminder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label String
  month Int // 1-12
  day   Int // 1-31

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("fiscal_reminder")
}

enum DocumentCategory {
  IDENTITE
  FISCALITE
  PATRIMOINE
  CONTRATS
  AUTRE
}

model Document {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  name     String
  category DocumentCategory @default(AUTRE)
  mimeType String
  size     Int
  data     Bytes

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@map("document")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
